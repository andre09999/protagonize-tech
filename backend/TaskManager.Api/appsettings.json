{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost\\SQLEXPRESS;Database=TaskManagerDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Issuer": "TaskManager.Api",
    "Audience": "TaskManager.Web",
    "Key": "change-this-super-secret-key-with-at-least-32-characters",
    "ExpirationMinutes": 120
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "DefaultExpirationMinutes": 10
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "Username": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "ExchangeName": "taskmanager.exchange",
    "QueueName": "taskmanager.tasks",
    "RoutingKey": "task.changed"
  },
  "AllowedHosts": "*"
}
